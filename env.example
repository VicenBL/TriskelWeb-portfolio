# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://triskel:triskel_password@localhost:5432/triskelweb

# Firebase Auth / Storage
# NEXT_PUBLIC Firebase web config is public browser configuration, not a secret.
# It is required only when using the client login page.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Auth token verification currently requires the server-only FIREBASE_PROJECT_ID.
# Storage/Admin SDK credentials are reserved for backend-mediated storage work.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correos
CORREOS_USERNAME=
CORREOS_PASSWORD=
CORREOS_CONTRACT_NUMBER=
CORREOS_CLIENT_NUMBER=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# App security
# Required for /api/auth/session. Use a random value with at least 32 bytes.
SESSION_SECRET=

# Private preview (server-only; protected by default)
# Exact origin: http://localhost:3000 locally, https://triskelfolk.es in production.
PREVIEW_ACCESS_MODE=protected
PREVIEW_ORIGIN=
# Generate locally with npm run preview:credentials (hidden interactive prompt).
PREVIEW_PASSWORD_HASH=
# Generate independently with npm run preview:credentials -- --session-secret.
PREVIEW_SESSION_SECRET=

# Docker PostgreSQL (set a private random password; never use demonstration values)
POSTGRES_PASSWORD=
# Private absolute directory on the future host, containing fullchain.pem and privkey.pem.
TRISKEL_TLS_DIRECTORY=

# Backups
BACKUP_DESTINATION=
